# ==============================================================================
# LedgerGuard Environment Configuration
# ==============================================================================

# Node Environment & Port
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Supabase Hosted or Plain Postgres)
# ------------------------------------------------------------------------------
# Transaction Pooler connection string for API (Port 6543 on Supabase)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Direct or Session Pooler connection string for pg-boss Worker (Port 5432 on Supabase)
# NOTE: pg-boss requires session-level LISTEN/NOTIFY and advisory locks
DATABASE_URL_WORKER=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Maximum connection pool clients
DB_POOL_MAX=20
DB_SSL=true

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Minimum 32-character secret for jose JWT signing
JWT_SECRET=ledgerguard_super_secure_jwt_secret_key_minimum_32_bytes_length
COOKIE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# URLs & CORS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Risk Engine Thresholds (0 - 100)
# ------------------------------------------------------------------------------
# Score 0 - 39: ALLOW (Instant settlement)
# Score 40 - 74: REVIEW (Held in PLATFORM_HOLD, queued in review_queue)
# Score 75 - 100: BLOCK (Failed immediately)
RISK_THRESHOLD_REVIEW=40
RISK_THRESHOLD_BLOCK=75

# ------------------------------------------------------------------------------
# Optional Non-Blocking LLM Explanations (Gemini / Claude)
# ------------------------------------------------------------------------------
# Choose: "gemini" or "claude"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
